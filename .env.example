# Copia questo file in ".env" (non committato, vedi .gitignore) e
# compila con le tue credenziali reali del bot Telegram.

TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_CHAT_ID=12345678

# Opzionali (valori di default già ragionevoli se li ometti)
PRICE_ALERT_THRESHOLD_PCT=0.05
PRICE_ALERT_INTERVAL_MINUTES=30
